# Node.js 24 LTS. Development uses HTTP; production requires your HTTPS origin.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
# Docker Compose + Caddy only, without scheme or path (e.g. luckybox.example.com).
SITE_HOST=
# SQLite on a LOCAL persistent disk; one application instance, never NFS/serverless.
DATA_DIR=./data
# Set to 1 only behind ONE trusted reverse proxy; block direct access to the app port.
TRUST_PROXY_HOPS=0
SESSION_HOURS=24
ALLOW_REGISTRATION=true
ALLOW_PAID_DRAWS=false
MANUAL_TOPUPS_ENABLED=false
# Emergency member points correction; not a payment/refund or VIP payment.
ADMIN_BALANCE_ADJUSTMENTS_ENABLED=false
PLATFORM_FEE_BPS=500
SETTLEMENT_HOLD_HOURS=48
# One-time seed only. No default account or password. Remove password after seed.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Dev-only opt-in: grant each new account test points (never allowed in production).
DEV_INITIAL_POINTS=0
# SMTP is optional. Without it password-reset requests are unavailable in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Backups must also be copied to your independent backup storage.
BACKUP_DIR=./data/backups

# ECPay AIO credit-card single payment. NT$1 = 1 point; maximum NT$20000/order.
# Disabled by default. Use a SEPARATE non-production DATA_DIR for stage tests.
ECPAY_ENABLED=false
ECPAY_MODE=stage
# Official PUBLIC STAGE credentials (never use these for production).
ECPAY_MERCHANT_ID=3002607
ECPAY_HASH_KEY=pwFHCqoQZGmho4w6
ECPAY_HASH_IV=EkRm7iFT261dpevs
# Set true only AFTER ECPay approves the actual points/prize business model.
ECPAY_LIVE_APPROVED=false

# Identity providers. Leave empty locally; buttons show not configured.
# Google OAuth Web client: redirect = PUBLIC_ORIGIN/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Cloudflare Turnstile: exact production hostname; secret stays server-side.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Twilio Verify. Account/service approval and SMS budget are required.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
SMS_DAILY_LIMIT=20
# Persistent 32-byte HEX encryption key. Generate once, back up securely, never commit.
# Set required=true only AFTER all admins have enrolled authenticator + saved recovery codes.
AUTH_SECRET=
ADMIN_MFA_REQUIRED=false

# Never enable without owner-approved exception/loss policy; not a bank refund switch.
REFUND_LOSS_APPROVALS_ENABLED=false
